<?xml version="1.0" encoding="utf-8"?>
<!-- Release and default: https only, system certificate authorities only. The debug build replaces this file (src/debug/res/xml) with one that also lists the development hosts. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
