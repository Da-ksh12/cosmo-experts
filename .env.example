# Copy to .env (docker compose reads it). PLACEHOLDERS ONLY: no real value belongs in this file or in git.
# Secrets are provided as files under ./secrets/ and referenced by NAME_FILE (see docs/PRODUCTION_CONFIGURATION.md and docs/SECRETS.md).

# ---- deployment
COSMO_DOMAIN=cosmo.example.org
COSMO_ACME_EMAIL=ops@example.org
WITH_TORCH=0

# ---- identity (Supabase Auth). The anon key is public by design; the service-role key is a SECRET and is read only by the backend.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_ANON_KEY=<public anon / publishable key>                (or SUPABASE_ANON_KEY_FILE)
# SUPABASE_SERVICE_ROLE_KEY_FILE=/run/secrets/supabase_service_role_key
# COSMO_COOKIE_SECURE=1            # production requires 1 (refresh cookie is Secure)
# COSMO_COOKIE_SAMESITE=strict
# COSMO_ALLOW_REGISTRATION=0       # 1 opens public self-registration (creates patients only)
# COSMO_CORS=https://cosmo.example.org

# ---- database (PostgreSQL). Production refuses SQLite unless COSMO_ALLOW_SQLITE_IN_PRODUCTION=1 is set deliberately.
# COSMO_DB=postgres
# COSMO_DATABASE_URL_FILE=/run/secrets/database_url                 # connects as the NOLOGIN-by-default role "cosmo_app" once the owner gave it a login (no BYPASSRLS)
# COSMO_MIGRATION_DATABASE_URL_FILE=/run/secrets/migration_database_url   # owner role, used only by scripts/migrate.py
# COSMO_DB_CONTEXT_SECRET_FILE=/run/secrets/db_context_secret       # >= 32 random characters; also installed in the database by scripts/migrate.py
# COSMO_MIGRATION_MODE=check       # off | check | apply  (apply additionally needs COSMO_ALLOW_STARTUP_MIGRATIONS=1)
# COSMO_DB_POOL_MIN=1
# COSMO_DB_POOL_MAX=10
# COSMO_DB_CONNECT_TIMEOUT=10
# COSMO_DB_STATEMENT_TIMEOUT_MS=30000

# ---- access policy
# COSMO_ADMIN_CLINICAL_ACCESS=none  # none | read. Production requires an explicit choice; "none" keeps administrators out of patient records.
