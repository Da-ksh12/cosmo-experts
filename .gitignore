# secrets and local state: never commit
.env
.env.*
!.env.example
secrets/
*.cbk
backend/data/
backend/.venv/
node_modules/
frontend/.next/
**/__pycache__/
*.sqlite3
.coverage
e2e/node_modules/
e2e/package-lock.json.bak
docs/*.log
docs/runs/p11_screens/
docs/runs/android_screens/
backend/content/urgent_policy.approved.json
*.pt
*.safetensors
*.gguf
*.onnx
frontend/tsconfig.tsbuildinfo

# Android release signing: the keystore, its passwords and any signing configuration never belong in Git (frontend/scripts/make-release-keystore.mjs keeps them in ~/.cosmo-signing)
*.jks
*.keystore
*.p12
*.pfx
keystore.properties
release-signing*.properties
.cosmo-signing/
frontend/out-android/
